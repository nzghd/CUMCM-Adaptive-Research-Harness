      "format": "json",
      "schema": "schemas/consistency_dimensions_config.schema.json",
      "stages": ["static", "consistency"]
    },
    {
      "id": "v51-stage-registry-config",
      "base": "project",
      "glob": "config/v51_stage_registry.json",
