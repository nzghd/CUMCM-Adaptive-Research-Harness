{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm-harness.local/schemas/claim_provenance_config.schema.json",
  "title": "Strong-Claim Provenance Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "claim_types", "weak_evidence_types", "note"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "claim_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["allowed_evidence_types", "recommended_downgrade"],
        "properties": {
          "allowed_evidence_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "recommended_downgrade": {"type": "string", "minLength": 1}
        }
      }
    },
    "weak_evidence_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "note": {"type": "string", "minLength": 1}
  }
}
