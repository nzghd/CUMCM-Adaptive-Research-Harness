{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm-harness.local/schemas/v51_stage_registry_config.schema.json",
  "title": "V5.1 Stage Registry Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "stages", "note"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "input_globs", "exclude_globs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 1},
          "input_globs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "exclude_globs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "note": {"type": "string", "minLength": 1}
  }
}
