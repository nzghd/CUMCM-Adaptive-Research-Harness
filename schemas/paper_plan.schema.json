{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUMCM Paper Plan",
  "type": "object",
  "required": ["schema_version", "profile", "working_title", "narrative_thesis", "sections"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "profile": {"type": "string", "minLength": 1},
    "working_title": {"type": "string"},
    "narrative_thesis": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "order", "required", "purpose", "file", "include_in_manuscript", "claim_ids", "source_paths", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "title": {"type": "string", "minLength": 1},
          "order": {"type": "integer"},
          "required": {"type": "boolean"},
          "purpose": {"type": "string"},
          "file": {"type": "string", "minLength": 1},
          "include_in_manuscript": {"type": "boolean"},
          "claim_ids": {"type": "array", "items": {"type": "string"}},
          "source_paths": {"type": "array", "items": {"type": "string"}},
          "figure_ids": {"type": "array", "items": {"type": "string"}},
          "table_ids": {"type": "array", "items": {"type": "string"}},
          "status": {"type": "string", "enum": ["planned", "drafting", "drafted", "reviewed", "final"]},
          "writer": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
