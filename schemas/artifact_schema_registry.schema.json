{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm-harness.local/schemas/artifact_schema_registry.schema.json",
  "title": "Artifact Schema Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "base", "glob", "format", "schema", "stages"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "base": {"enum": ["project", "run"]},
          "glob": {"type": "string", "minLength": 1},
          "format": {"enum": ["json", "csv"]},
          "schema": {"type": "string", "pattern": "^schemas/[^/]+\\.json$"},
          "producer_contract": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$"},
          "stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "static",
                "G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7",
                "interpretation",
                "structural_validation",
                "mathematical_construction",
                "independent_review",
                "strong_claim_audit",
                "consistency",
                "paper_extension",
                "submission",
                "package",
                "relay"
              ]
            }
          }
        }
      }
    }
  }
}
