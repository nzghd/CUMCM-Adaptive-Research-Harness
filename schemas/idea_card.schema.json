{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "target_nodes",
    "summary",
    "method_families",
    "validation_plan",
    "main_risks",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^IDEA_[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "target_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "method_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "validation_plan": {
      "type": "array"
    },
    "main_risks": {
      "type": "array"
    },
    "status": {
      "type": "string"
    }
  }
}
