{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "plan_id",
    "goal",
    "workstreams"
  ],
  "properties": {
    "workstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "agent",
          "backend",
          "objective",
          "read_scope",
          "write_scope",
          "expected_outputs",
          "stop_condition"
        ]
      }
    }
  }
}
