{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm-harness.local/schemas/strong_claim.schema.json",
  "title": "Strong Claim CSV Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "path",
    "line",
    "claim_type",
    "matched_phrase",
    "excerpt",
    "evidence_type",
    "evidence_ref",
    "status",
    "recommended_wording",
    "reviewed_by",
    "reviewed_at",
    "notes"
  ],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "line": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "claim_type": {"type": "string", "minLength": 1},
    "matched_phrase": {"type": "string", "minLength": 1},
    "excerpt": {"type": "string", "minLength": 1},
    "evidence_type": {"type": "string"},
    "evidence_ref": {"type": "string"},
    "status": {"enum": ["open", "supported", "downgraded", "rejected", "not_applicable"]},
    "recommended_wording": {"type": "string"},
    "reviewed_by": {"type": "string"},
    "reviewed_at": {"type": "string"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "supported"}}},
      "then": {
        "properties": {
          "evidence_type": {"minLength": 1},
          "evidence_ref": {"minLength": 1},
          "reviewed_by": {"minLength": 1},
          "reviewed_at": {"minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "downgraded"}}},
      "then": {
        "properties": {
          "recommended_wording": {"minLength": 1},
          "reviewed_by": {"minLength": 1},
          "reviewed_at": {"minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["rejected", "not_applicable"]}}},
      "then": {
        "properties": {
          "reviewed_by": {"minLength": 1},
          "reviewed_at": {"minLength": 1}
        }
      }
    }
  ]
}
