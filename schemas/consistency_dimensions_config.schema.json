{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cumcm-harness.local/schemas/consistency_dimensions_config.schema.json",
  "title": "Consistency Dimensions Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "dimensions", "allowed_status", "note"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "required", "allow_not_applicable"],
        "properties": {
          "id": {"type": "string", "pattern": "^CNS-[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "allow_not_applicable": {"type": "boolean"}
        }
      }
    },
    "allowed_status": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["PASS", "PASS_WITH_TOLERANCE", "FAIL", "NOT_TESTED", "NOT_APPLICABLE"]}
    },
    "note": {"type": "string", "minLength": 1}
  }
}
